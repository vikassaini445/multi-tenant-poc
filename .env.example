# Superuser connection. Used ONLY by `npm run db:bootstrap` to create the two
# roles below. Never given to the application.
ADMIN_DATABASE_URL=postgres://postgres:postgres@localhost:5434/mt_poc

# Migration/owner role. Owns the tables and configures RLS.
# Role name and password are taken from this URL by the bootstrap step.
MIGRATION_DATABASE_URL=postgres://mt_owner:owner_dev_password@localhost:5434/mt_poc

# Application role. NOSUPERUSER, NOBYPASSRLS, does not own any table.
DATABASE_URL=postgres://mt_app:app_dev_password@localhost:5434/mt_poc

DB_POOL_MAX=10

# HS256 signing secret for the POC's JWTs. Use a long random value outside dev.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ISSUER=mt-poc-auth
JWT_AUDIENCE=mt-poc-api

PORT=3000
